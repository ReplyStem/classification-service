# ─────────────────────────────────────────────────────────────────────────────
# Classification Microservice - Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.

# JWT Authentication
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=your-super-secret-key-here
JWT_ALGORITHM=HS256

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/classification_service.log

# Classification Thresholds
INTENT_CONFIDENCE_THRESHOLD=0.5
SENTIMENT_CONFIDENCE_THRESHOLD=0.5
TOP_K_ALTERNATIVES=3

# Model Configuration (HuggingFace model names)
INTENT_MODEL_NAME=typeform/distilbert-base-uncased-mnli
SENTIMENT_MODEL_NAME=cardiffnlp/twitter-xlm-roberta-base-sentiment

# API Server
API_HOST=0.0.0.0
API_PORT=8000
